VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Leave empty in Vercel production (same-origin /api).
VITE_API_URL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_SESSION_SECRET=
ADMIN_JWT_SECRET=
STUDENT_JWT_SECRET=

EXAM_DURATION_MINUTES=60
PORT=3001

# Code execution — REQUIRED for C/Java/Python on Vercel (server-only, never VITE_)
# Free provider: OnlineCompiler.io (https://onlinecompiler.io)
# Get an API key: sign up → https://api.onlinecompiler.io → API Keys
EXECUTION_PROVIDER=onlinecompiler
ONLINECOMPILER_API_KEY=
# Optional overrides (defaults shown):
# ONLINECOMPILER_API_URL=https://api.onlinecompiler.io
# ONLINECOMPILER_COMPILER_PYTHON=python-3.14
# ONLINECOMPILER_COMPILER_C=gcc-15
# ONLINECOMPILER_COMPILER_JAVA=openjdk-25

# Cap parallel executions. OnlineCompiler free sync limit is 4 concurrent.
# Keep this ≤ 4 on the free tier to reduce 429s. Excess jobs wait in-process.
MAX_CONCURRENT_EXECUTIONS=4

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
